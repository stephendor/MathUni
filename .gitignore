*.pyc
.pytest_cache/
state/sessions/*.tmp
*.tmp


#Ignore insiders AI rules
.github\instructions\codacy.instructions.md
.aider*

# Derived per-run daily state: regenerated by scripts/daily.py on every
# run, local to this machine. The session plan under state/sessions/ is
# the durable record and stays tracked.
state/today.json
state/last-daily-run.json
# Port, per-run token and pid of the local server.
state/server.json
# Written only when the server runs windowless (pythonw has no console).
state/server.log

# Derived boards, rewritten by scripts/daily.py on every run. Both are pure
# functions of things already tracked -- problems.html of progress + mastery,
# reference.html of the 145 lessons -- so committing them would track a 950 KB
# artifact that changes whenever either source does, and can be rebuilt with
# `python scripts/problem_board.py` and `python scripts/reference.py`.
dashboard/problems.html
dashboard/reference.html
